{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/enquiries.mjs": {
      "maxDuration": 30,
      "includeFiles": "src/services.json"
    }
  },
  "redirects": [
    {
      "source": "/about-us.html",
      "destination": "/#how-we-work",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/run.html",
      "destination": "/services/managed-outbound-operations",
      "permanent": true
    },
    {
      "source": "/how-it-runs.html",
      "destination": "/services/managed-outbound-operations",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/services/:service",
      "destination": "/services/:service/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'"
        }
      ]
    }
  ]
}
